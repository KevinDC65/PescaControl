{
  "name": "pescacontrol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch db.json --port 3001",
    "dev:all": "concurrently -n api,web -c blue,green \"npm:server\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "json-server": "^0.17.4",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.6"
  },
  "description": "PescaControl: sistema de gestión de operaciones pesqueras y desembarque (React + Vite + Bootstrap + json-server)",
  "engines": {
    "node": ">=20.19"
  }
}
