# Copia este archivo a .env y cambia los valores antes de usar el proyecto.

# Frontend: prefijo de la API (Vite lo redirige al servidor en desarrollo).
VITE_API_URL=/api

# Servidor
# Puerto del servidor de la API (Vite redirige /api a este puerto).
API_PORT=3001
# Secreto para firmar las sesiones. Usa una cadena larga y aleatoria, distinta en cada equipo.
JWT_SECRET=cambia-este-valor-por-una-cadena-larga-y-aleatoria
# true solo si la app se sirve por HTTPS.
COOKIE_SECURE=false

# Usuarios de demostración que crea `npm run seed` (solo para pruebas locales).
DEMO_JEFE_CORREO=jefe@pescacontrol.pe
DEMO_JEFE_CLAVE=Muelle2026
DEMO_OPERADOR_CORREO=operador@pescacontrol.pe
DEMO_OPERADOR_CLAVE=Anchoveta2026
